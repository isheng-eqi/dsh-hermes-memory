{
  "name": "dsh-hermes-memory",
  "version": "1.2.0",
  "description": "Hermes-style persistent memory for DeepSeek Harness: bounded dual banks, add/patch/replace/remove and atomic batches, frozen session snapshots, content checks, and a web panel. No additional LLM calls or external runtime dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "host.js",
    "client.js",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/2026-11-09_compatibility-and-hermes-report.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "long-term-memory",
    "hermes-agent",
    "cordis"
  ],
  "license": "MIT",
  "author": "isheng-eqi",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isheng-eqi/dsh-hermes-memory.git"
  },
  "homepage": "https://github.com/isheng-eqi/dsh-hermes-memory#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
